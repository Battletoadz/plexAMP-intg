# =============================================================================
# PlexAmp Universal Integration - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Tidal Developer Credentials
# Get these from: https://developer.tidal.com/dashboard
# -----------------------------------------------------------------------------
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Tidal OAuth Redirect URI (must match what's configured in your Tidal dev app)
TIDAL_REDIRECT_URI=https://example.com/callback

# Tidal API region / country code (ISO 3166-1 alpha-2)
TIDAL_COUNTRY_CODE=US

# Tidal audio quality: LOW, HIGH, LOSSLESS, HI_RES, HI_RES_LOSSLESS
TIDAL_AUDIO_QUALITY=LOSSLESS

# Tidal platform preset: WEB, ANDROID, IOS
TIDAL_PLATFORM=WEB

# -----------------------------------------------------------------------------
# Tidal Auth Tokens (populated automatically after first login)
# You can also manually paste them here after running: tidal-bridge auth login
# -----------------------------------------------------------------------------
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_TOKEN_EXPIRY=

# -----------------------------------------------------------------------------
# Plex Server Configuration
# -----------------------------------------------------------------------------

# Your Plex server URL (usually http://localhost:32400 or your LAN IP)
PLEX_URL=http://localhost:32400

# Plex authentication token
# Find yours: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
# Or claim a new server: https://www.plex.tv/claim/
PLEX_TOKEN=

# Name of your Plex music library section
PLEX_MUSIC_LIBRARY=Music

# Plex client identifier (unique string for this integration)
PLEX_CLIENT_ID=plexamp-tidal-bridge

# Plex product name (shows up in Plex dashboard)
PLEX_PRODUCT_NAME=PlexAmp Tidal Bridge

# -----------------------------------------------------------------------------
# Bridge Service Configuration
# -----------------------------------------------------------------------------

# Host and port for the Python tidal-bridge REST API
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9120

# Host and port for the Go plex-sync service
SYNC_HOST=127.0.0.1
SYNC_PORT=9121

# Sync interval in minutes (how often to poll Tidal for changes)
SYNC_INTERVAL_MINUTES=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable request caching for Tidal API (reduces API calls)
TIDAL_CACHE_ENABLED=true

# Cache TTL in seconds (default 1 hour)
TIDAL_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Sync Behavior
# -----------------------------------------------------------------------------

# Sync Tidal favorites to a Plex playlist
SYNC_FAVORITES=true
SYNC_FAVORITES_PLAYLIST_NAME=Tidal Favorites

# Sync all Tidal playlists to Plex playlists
SYNC_PLAYLISTS=true

# Prefix for synced playlist names in Plex (empty = no prefix)
SYNC_PLAYLIST_PREFIX=[Tidal]

# Sync Tidal mixes as Plex playlists (replaces AI-based Sonic Analysis/DJ)
SYNC_MIXES=true
SYNC_MIXES_PREFIX=[Tidal Mix]

# Sync Tidal recommendations as Plex playlists
SYNC_RECOMMENDATIONS=true
SYNC_RECOMMENDATIONS_PREFIX=[Tidal Radio]

# Delete Plex playlists that no longer exist on Tidal
SYNC_DELETE_ORPHANED=false

# Maximum number of tracks per synced playlist (0 = unlimited)
SYNC_MAX_TRACKS_PER_PLAYLIST=0

# -----------------------------------------------------------------------------
# Data Storage
# -----------------------------------------------------------------------------

# Directory for persistent data (token cache, sync state, metadata cache)
DATA_DIR=./data
